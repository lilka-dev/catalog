{
  "name": "lilka-catalog-api",
  "version": "1.0.0",
  "description": "Backend for sharing Lilka apps on catalog.lilka.dev",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply lilka-catalog --local",
    "db:migrate": "wrangler d1 migrations apply lilka-catalog --remote",
    "smoke": "bash scripts/smoke.sh"
  },
  "license": "GPL-2.0-or-later",
  "type": "module",
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.3"
  },
  "private": true
}
